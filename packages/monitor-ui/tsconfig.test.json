{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "dist-test",
    "rootDir": "src"
  },
  "include": [
    "src/derive.ts",
    "src/graphModel.ts",
    "src/routes.ts",
    "src/types.ts",
    "src/test/**/*.ts"
  ]
}
