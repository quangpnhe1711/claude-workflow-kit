{
  "name": "claude-workflow-kit",
  "version": "0.1.0",
  "description": "Portable risk-adaptive Claude Code workflow with proportional verification, L3 hard gates, reusable reports, and a live monitor",
  "keywords": ["claude", "claude-code", "workflow", "agent", "monitor"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "claude-workflow-kit": "./bin/claude-workflow-kit.mjs",
    "cw": "./bin/cw.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@claude-workflow-kit/claude-adapter": "0.1.0",
    "@claude-workflow-kit/monitor-server": "0.1.0",
    "@claude-workflow-kit/monitor-ui": "0.1.0",
    "@claude-workflow-kit/workflow-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
